# ─── Anthropic ────────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Get from: https://upstash.com/ → Create Redis database → REST API
# Used for: session storage, rate limiting
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get from: https://dashboard.stripe.com/webhooks → Add endpoint
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe
# Events to listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: persistent Stripe Product IDs (prod_…), one per product. Set these to
# tie checkout to catalog Products so coupons can be restricted to a specific
# product. The CHARGED PRICE still comes from lib/pricing.ts — these are for
# identity/coupons only. Leave unset to use inline products (promo codes still
# work order-wide). Create the Products at https://dashboard.stripe.com/products
STRIPE_PRODUCT_BRIEF=prod_...
STRIPE_PRODUCT_SHIELD=prod_...

# ─── App ──────────────────────────────────────────────────────────────────────
# Your production domain (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# ─── Access control ─────────────────────────────────────────────────────────
# Secret used to sign per-session report access cookies AND preview-pass cookies.
# REQUIRED in production (the app refuses to mint/verify access without it).
# Use a long random value:
#   openssl rand -hex 32
ACCESS_TOKEN_SECRET=

# ─── Bot gate (Cloudflare Turnstile) ────────────────────────────────────────
# Protects the free, pre-payment AI endpoints from automated cost-abuse.
# Get keys from: https://dash.cloudflare.com/ → Turnstile → Add site
# In production the gate now FAILS CLOSED when unconfigured: if these keys are
# missing, the free preview endpoints are refused (so a dropped key can't
# silently disable bot protection in front of the paid-for Claude calls).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Escape hatch — set to "true" to intentionally run the preview pipeline UNGATED
# in production (only do this if you accept the cost-abuse risk). Leave unset otherwise.
ALLOW_UNGATED_PREVIEW=

# ─── Transactional email (Resend) ───────────────────────────────────────────
# Sends the "your report is ready" magic link + failure notices.
# DORMANT until RESEND_API_KEY is set. Get a key + verify your sending domain at
# https://resend.com/. EMAIL_FROM must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM="HomeReview AI <reports@gethomereview.com>"
# Optional: where internal ops alerts (failed reports, spend ceiling) are sent.
OPS_ALERT_EMAIL=

# ─── Error tracking (Sentry) ─────────────────────────────────────────────────
# DORMANT until NEXT_PUBLIC_SENTRY_DSN is set. Get it from your Sentry project.
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only needed to upload source maps at build time:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ─── Sanity CMS (Learn content) ──────────────────────────────────────────────
# The Learn section is edited in Sanity Studio. Project ID + dataset are public
# (safe to expose); they have committed defaults, so these are only needed to
# point at a different project/dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=4j57wsdj
NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Shared secret for the publish → revalidate webhook (POST /api/revalidate?secret=…).
# Generate: openssl rand -hex 24
SANITY_REVALIDATE_SECRET=
# Write token — ONLY needed to run the one-time content migration (`npm run seed`).
# Create in Sanity → API → Tokens (Editor role). Do NOT expose to the browser.
SANITY_API_WRITE_TOKEN=

# ─── Analytics ───────────────────────────────────────────────────────────────
# Vercel Web Analytics — no key needed; enable it in the Vercel dashboard
# (Project → Analytics). Custom funnel events are emitted automatically.

# ─── Admin / support console (optional) ─────────────────────────────────────
# Enables /admin (session lookup + refunds). DISABLED unless set (>=16 chars).
#   openssl rand -hex 24
ADMIN_SECRET=

# ─── Spend ceilings (optional) ──────────────────────────────────────────────
# Global per-UTC-day caps across ALL callers — a circuit breaker independent of
# per-IP limits. Defaults apply if unset (preview 5000/day, questions 8000/day).
# DAILY_PREVIEW_CEILING=5000
# DAILY_QUESTIONS_CEILING=8000
