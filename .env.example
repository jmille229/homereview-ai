# ─── Anthropic ────────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Get from: https://upstash.com/ → Create Redis database → REST API
# Used for: session storage, rate limiting
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get from: https://dashboard.stripe.com/webhooks → Add endpoint
# Endpoint URL: https://yourdomain.com/api/webhooks/stripe
# Events to listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── App ──────────────────────────────────────────────────────────────────────
# Your production domain (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# ─── Access control ─────────────────────────────────────────────────────────
# Secret used to sign per-session report access cookies. REQUIRED in production
# (the app refuses to mint/verify access without it). Use a long random value:
#   openssl rand -hex 32
ACCESS_TOKEN_SECRET=
